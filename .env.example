# =================================================================
# CAMPUSCONNECT — ENVIRONMENT CONFIGURATION
# =================================================================

# Database URL
# SQLite default (zero-setup out-of-the-box local development):
DATABASE_URL="file:./dev.db"

# PostgreSQL production connection string (when running PostgreSQL server):
# DATABASE_URL="postgresql://postgres:password@localhost:5432/campus_lost_found?schema=public"

# Backend Settings
PORT=5000
NODE_ENV=development
JWT_SECRET=campus_connect_jwt_secret_dev_key_2026_xyz987
JWT_EXPIRES_IN=7d
FRONTEND_URL=http://localhost:5173
NOTIFICATION_SERVICE_URL=http://localhost:5001
UPLOAD_DIR=./uploads

# Notification Microservice Settings
NOTIFICATION_PORT=5001

# Optional SMTP Mail Server Settings (leave blank for local simulation/logging)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM="CampusConnect Notifications <noreply@campusconnect.edu>"
